# Copy this file to .env.local and fill in your own Supabase project's values
# (Project Settings → API). .env.local is never committed.
#
# Both values are public by design — they ship in the browser bundle — but
# this example keeps placeholders so a fresh clone runs in offline demo mode
# instead of connecting to someone else's project.
#
# Never put the service_role / sb_secret key or any Paystack secret here.
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_ANON_KEY="your-publishable-key"
